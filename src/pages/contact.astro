---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Email from '../components/Email.astro';
import { contact, site } from '../data/site';
import hero from '../assets/work/stella-2.webp';
---
<BaseLayout title="Contact" description="Get in touch with Dine Albrecht about your website, app or product." headerOverlay contactBlock={false}>
  <div class="hero">
    <Image src={hero} alt="Stella Sport athlete profile page" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
  </div>
  <section class="band dark">
    <div class="wrap grid">
      <h1 class="display">{contact.heading}</h1>
      <div class="right">
        <p class="lede">{contact.line}</p>
        <Email class="mail" />
      </div>
    </div>
    <div class="wrap row4 meta foot">
      <span>{site.availability}</span>
      <span class="hide-sm">{site.location}</span>
      <span class="hide-sm">Designed &amp; built by Dine</span>
      <span><a href="/privacy" class="link-u">Privacy</a> · <a href="/impressum" class="link-u">Impressum</a> · ©{site.year}</span>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { height: 66svh; overflow: hidden; }
  .hero img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .band { min-height: 34svh; display: grid; grid-template-rows: 1fr auto; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); padding-block: clamp(40px, 5vw, 72px); align-items: start; }
  .right { display: grid; gap: 28px; }
  .band :global(.mail) { font-size: clamp(1.5rem, 3vw, 3.2rem); letter-spacing: -.04em; line-height: 1; text-transform: uppercase; overflow-wrap: anywhere; justify-self: start;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; padding-bottom: 4px; }
  .foot { padding-block: 18px; border-top: 1px solid var(--line); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
