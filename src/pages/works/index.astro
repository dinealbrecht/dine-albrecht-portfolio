---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { cases } from '../../data/cases';
---
<BaseLayout title="Work" description="Case studies: websites, games and apps for Red Bull, Rolex, McLaren, Stella McCartney, Heathrow and more.">
  <section class="intro wrap">
    <h1 class="display">Case studies<sup>({cases.length})</sup></h1>
  </section>

  <div class="wrap toggle meta" role="group" aria-label="Layout">
    <button type="button" data-set="grid" aria-pressed="true">Grid</button>
    <span aria-hidden="true">/</span>
    <button type="button" data-set="list" aria-pressed="false">List</button>
  </div>

  <div class="views" data-view="grid">
    <div class="v-grid"><WorkGrid items={cases} eagerFirst /></div>

    <ol class="v-list wrap">
      {cases.map((c, i) => (
        <li>
          <a href={`/works/${c.slug}`}>
            <span class="meta n">{String(i + 1).padStart(2, '0')}</span>
            <span class="client">{c.client}</span>
            <span class="t muted">{c.title}</span>
            <span class="meta type">{c.type}</span>
            <span class="thumb media" aria-hidden="true">
              <Image src={c.hero.src} alt="" widths={[480]} sizes="240px" loading="lazy" />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="spacer"></div>
</BaseLayout>

<style>
  .intro { min-height: 52svh; display: grid; align-items: end; padding-bottom: clamp(24px, 3vw, 40px); }
  sup { font-size: .22em; letter-spacing: 0; vertical-align: super; margin-left: .15em; font-weight: 400; }
  .toggle { display: flex; justify-content: flex-end; gap: .6em; padding-bottom: clamp(40px, 5vw, 72px); }
  .toggle button[aria-pressed='false'] { color: var(--muted); opacity: .6; }
  .views[data-view='grid'] .v-list, .views[data-view='list'] .v-grid { display: none; }
  .spacer { height: clamp(80px, 10vw, 160px); }

  .v-list { list-style: none; border-bottom: 1px solid var(--line); }
  .v-list li { border-top: 1px solid var(--line); }
  .v-list a { position: relative; display: grid; grid-template-columns: 1fr 3fr 4fr 2fr; gap: var(--gutter); align-items: baseline; padding-block: 18px 22px; }
  .client { font-size: clamp(1.6rem, 3.4vw, 3.6rem); text-transform: uppercase; letter-spacing: -.04em; line-height: .95; }
  .type { justify-self: end; }
  .thumb { position: absolute; right: 18%; top: 50%; width: 240px; aspect-ratio: 16/10; translate: 0 -50%; opacity: 0; scale: .96; pointer-events: none; transition: opacity .3s, scale .4s var(--ease); z-index: 2; }
  .v-list a:hover .thumb, .v-list a:focus-visible .thumb { opacity: 1; scale: 1; }
  .v-list a:hover .client { font-style: normal; }
  @media (max-width: 720px) {
    .v-list a { grid-template-columns: auto 1fr; row-gap: 6px; }
    .t { grid-column: 2; } .type { display: none; } .thumb { display: none; }
  }
</style>

<script>
  const views = document.querySelector<HTMLElement>('.views')!;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set]');
  const set = (v: string) => {
    views.dataset.view = v;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === v)));
    try { localStorage.setItem('works-view', v); } catch {}
  };
  try { const saved = localStorage.getItem('works-view'); if (saved) set(saved); } catch {}
  buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.set!)));
</script>
